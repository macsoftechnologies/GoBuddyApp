<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_5sdp"
        android:layout_marginRight="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Image -->
            <ImageView
                android:id="@+id/subimageView"
                android:src="@drawable/mask_group"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="100dp" />

            <!-- Subcategory Name -->
            <TextView
                android:id="@+id/subcategoryTextview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:background="#fff"
                android:ellipsize="end"
                android:lines="3"
                android:maxLines="3"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                tools:text="Cleaning and \n Washing" />

            <!-- Price Text -->
            <TextView
                android:id="@+id/priceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:background="#fff"
                android:text="@string/indian_rupee"
                android:textColor="#55901D"
                android:textSize="@dimen/_10sdp"
                android:layout_gravity="start" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qty"
                android:visibility="gone"
                android:id="@+id/quantity_dailog"
                android:layout_gravity="end"
                android:padding="@dimen/_5ssp"
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/quantum_googgreen"/>

            <!-- Quantity Section with Plus/Minus Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btn_layout"
                android:visibility="gone"
                android:orientation="horizontal"
                android:padding="0dp"
                android:layout_marginRight="@dimen/_5ssp"
                android:layout_marginBottom="5dp"
                android:layout_marginTop="2dp"
                android:gravity="end">

                <!-- Minus Button -->
                <Button
                    android:id="@+id/btnMinus"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:text="-"

                    android:padding="@dimen/_1ssp"
                    android:layout_marginRight="6dp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:background="@drawable/button_background"
                    android:textColor="@android:color/holo_orange_dark" />

                <!-- Quantity Text -->
                <TextView
                    android:id="@+id/quantityTextView"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"

                    android:background="@drawable/quantity_text_bg"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:layout_gravity="center"/>

                <!-- Plus Button -->
                <Button
                    android:id="@+id/btnPlus"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:text="+"

                    android:layout_marginRight="4dp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/button_background"
                    android:textColor="@android:color/holo_orange_dark" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
