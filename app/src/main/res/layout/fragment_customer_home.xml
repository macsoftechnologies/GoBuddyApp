<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/fragment_containe_home"
    android:orientation="vertical"
    tools:context=".view.fragments.customerFragments.CustomerHomeFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/customerMainToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/white"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <ImageView
            android:id="@+id/toolBarQuestionBtn"
            android:visibility="gone"

            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_gravity="end"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:src="@drawable/ic_baseline_help_24" />


        <ImageView
            android:id="@+id/add_location"
            android:layout_width="@dimen/_30sdp"
            android:visibility="gone"
            android:layout_height="@dimen/_30sdp"
            android:layout_gravity="end"
            android:src="@drawable/ic_baseline_add_location_24"/>
        <ImageView
            android:id="@+id/toolBarIcon"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="?actionBarSize"
            android:layout_gravity="end"
            android:layout_marginRight="@dimen/_10sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:src="@drawable/app_icon" />

        <ImageView
            android:layout_width="@dimen/_30sdp"
            android:layout_height="?actionBarSize"
            android:id="@+id/profileperson"
            android:visibility="visible"
            android:layout_gravity="start"
            android:src="@drawable/ic_baseline_person_pin_24"/>
        <TextView
            android:id="@+id/toolBarLoginBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"

            android:layout_marginEnd="@dimen/_10sdp"
            android:text="@string/login"
            android:textAllCaps="true"
            android:layout_marginLeft="5dp"
            android:textColor="@android:color/black"
            android:textSize="@dimen/_12ssp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:id="@+id/profilelayout"
            android:layout_marginTop="@dimen/_1ssp"
            android:visibility="gone"
            android:orientation="vertical">
        <TextView
            android:id="@+id/profileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="name"
            android:textAllCaps="true"
            android:textColor="@android:color/black"
            android:textSize="@dimen/_12ssp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1ssp"
                android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"

                android:text="ORDERING FROM: "
                android:textSize="@dimen/_7sdp"/>
                <TextView
                    android:id="@+id/edit_profile_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VISAKHAPATNAM "
                    android:drawableRight="@drawable/ic_baseline_mode_edit_24"
                    android:textSize="@dimen/_9sdp"
                       android:textColor="@color/quantum_orange"/>

            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/toolBarIcons"
            android:layout_width="@dimen/_37sdp"
            android:layout_height="50dp"
            android:layout_gravity="end"
            android:visibility="gone"
            android:layout_marginRight="15dp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:src="@drawable/app_icon" />


    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:scrollbars="none">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

           <!-- <androidx.viewpager.widget.ViewPager
                android:id="@+id/adds_imageSlider"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="10dp"
                android:layout_height="wrap_content" />-->

            <com.glide.slider.library.SliderLayout
                android:id="@+id/homePageImageSlider"
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:layout_height="@dimen/_160sdp"
                android:layout_marginLeft="@dimen/_9sdp"
                android:layout_marginRight="@dimen/_9sdp"
                app:indicator_visibility="visible" />
            <com.glide.slider.library.SliderLayout
                android:id="@+id/homePageImageSliderlocation"
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"

                android:visibility="gone"
                android:layout_height="@dimen/_160sdp"
                android:layout_marginLeft="@dimen/_9sdp"
                android:layout_marginRight="@dimen/_9sdp"
                app:indicator_visibility="visible" />
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_13sdp"
                app:cardCornerRadius="20dp"
                app:cardElevation="5dp">

                <EditText
                    android:id="@+id/cust_home_searchView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:drawableStart="@drawable/ic_search_black_24dp"
                    android:drawablePadding="15dp"
                    android:hint="@string/SearchForServices"
                    android:imeOptions="actionSearch"
                    android:inputType="none"

                    android:maxLines="1"
                    android:textSize="@dimen/_12ssp"
                    android:focusableInTouchMode="false"
                    android:padding="@dimen/_6sdp" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/services_no"
                android:layout_width="match_parent"
                android:gravity="center"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:text="@string/no_services_are_avliable_at_your_current_location"
                android:textStyle="italic"
                android:textColor="@color/quantum_googred"
                android:textSize="20sp"
                android:layout_gravity="center"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cust_home_services_recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                android:paddingEnd="@dimen/_10sdp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"
                tools:listitem="@layout/custom_service_item" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cust_Location_home_services_recyclerView"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                android:paddingEnd="@dimen/_10sdp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"
                tools:listitem="@layout/custom_service_item" />
        </LinearLayout>


    </androidx.core.widget.NestedScrollView>


</LinearLayout>