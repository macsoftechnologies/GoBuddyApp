<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    tools:context=".view.fragments.customerflowfragments.PlaceOrderFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/placeOrder_addressChangeBtn"
                android:text="@string/job_location"
                android:textColor="#000"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/placeOrder_addressChangeBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/curved_green_bg"
                android:paddingLeft="@dimen/_10sdp"
                android:paddingRight="@dimen/_10sdp"
                android:text="@string/change"
                android:textColor="#fff"
                android:textSize="@dimen/_12ssp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/placeOrder_nameView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:textColor="#000"
            android:textSize="@dimen/_14ssp"
            tools:text="Mr. Naveen Kadiyala" />

        <TextView
            android:id="@+id/placeOrder_addressView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:textColor="#000"
            android:textSize="@dimen/_14ssp"
            tools:text="D.no : 4-309, Old Gaigolupadu, Kakinada - 533005" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="@string/dateAndTime"
            android:textColor="#000"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/placeOrder_dateView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:textColor="#000"
            android:textSize="@dimen/_14ssp"
            tools:text="May 15, 2019, Evening(3PM - 6PM)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="@dimen/_10sdp"
            android:background="@color/colorGrey" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="@string/orderDetails"
            android:textColor="#000"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />



        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp">

            <TextView
                android:id="@+id/placeOrder_TitleView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_toStartOf="@id/placeOrder_priceView"
                android:maxLines="2"
                android:textColor="#000"
                android:textSize="@dimen/_14ssp"
                tools:text="Window Ac Service" />




            <TextView
                android:id="@+id/placeOrder_priceView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="sans-serif"
                android:textColor="#000"
                android:textSize="@dimen/_18ssp"
                tools:text="\u20B9 500" />



        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp">

        <TextView
            android:id="@+id/sft_units"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:visibility="gone"
            android:text="SFT units"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_toStartOf="@id/qty_units"
            android:maxLines="2"
            android:textColor="#000"
            android:textSize="@dimen/_13ssp"
            />

        <TextView

             android:id="@+id/qty_units"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:visibility="gone"
            android:fontFamily="sans-serif"
            android:textColor="#000"
            android:textSize="@dimen/_18ssp"
            tools:text="\u20B9 500" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp">

            <TextView
                android:id="@+id/extra_charges_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                android:maxLines="2"
                android:textColor="#000"
                android:textSize="@dimen/_14ssp"
                tools:text="Window Ac Service" />

            <TextView
                android:id="@+id/extra_charges_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="#000"
                android:fontFamily="sans-serif"
                android:textSize="@dimen/_18ssp"
                tools:text="\u20B9 500" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/travel_layout"
            android:visibility="gone"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp">

            <TextView
                android:id="@+id/Travel_charges"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                android:maxLines="2"
                android:visibility="visible"
                android:textColor="#000"
                android:textSize="@dimen/_14ssp"
                tools:text="Travel Charges" />

            <TextView
                android:id="@+id/Travel_charges_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="#000"
                android:fontFamily="sans-serif"
                android:textSize="@dimen/_18ssp"
                tools:text="\u20B9 500" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp">

            <TextView
                android:id="@+id/total_price_txtview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                android:maxLines="2"
                android:textColor="#000"
                android:textSize="@dimen/_14ssp"
                android:text="@string/total" />

            <TextView
                android:id="@+id/total_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="#000"
                android:fontFamily="sans-serif"
                android:textSize="@dimen/_18ssp"
                tools:text="\u20B9 500" />
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/couponAppliedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:text="@string/coupon_applied"
                android:textColor="#000"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_toStartOf="@id/placeOrder_couponPriceView"
                    android:maxLines="2"
                    android:text="@string/coupon_price"
                    android:textColor="#000"
                    android:textSize="@dimen/_14ssp" />

                <TextView
                    android:id="@+id/placeOrder_couponPriceView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textColor="#000"
                    android:textSize="@dimen/_18ssp"
                    tools:text="\u20B9 500" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_toStartOf="@id/placeOrder_finalPriceView"
                    android:maxLines="2"
                    android:text="@string/discounted_price"
                    android:textColor="#000"
                    android:textSize="@dimen/_14ssp" />

                <TextView
                    android:id="@+id/placeOrder_finalPriceView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textColor="#000"
                    android:textSize="@dimen/_18ssp"
                    tools:text="\u20B9 500" />
            </RelativeLayout>

            <TextView
                android:id="@+id/removeCouponBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/_10sdp"
                android:text="@string/remove_coupon"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/couponApplyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/couponEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_weight="1.5">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_your_coupon_here"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/applyCouponBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.5"
                android:background="@drawable/curved_green_bg"
                android:paddingLeft="@dimen/_10sdp"
                android:paddingRight="@dimen/_10sdp"
                android:text="@string/apply"
                android:textAlignment="center"
                android:textColor="#fff"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            android:background="@drawable/dotted_black_rectangle"
            android:drawableStart="@drawable/ic_danger"
            android:drawablePadding="@dimen/_10sdp"
            android:padding="@dimen/_10sdp"
            android:text="@string/estimated_price"
            android:textColor="#000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="@string/selectpayment"
            android:textColor="#000"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/onlineLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_margin="@dimen/_10sdp"
            android:background="@drawable/grey_rectangle_box"
            android:orientation="vertical"
            android:padding="@dimen/_5sdp">


            <TextView
                android:id="@+id/payOnlineTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_tick_nonactive"
                android:drawablePadding="@dimen/_10sdp"
                android:textColor="@color/quantum_googgreen"
               android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/upon_completion_of_services"
                android:textAlignment="center"
                android:textSize="@dimen/_10ssp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="&#8226; Manual hand fee is absolutely free   "
                android:textAlignment="center"
                android:textSize="@dimen/_10ssp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"

                android:text=" &#8226; Pay the rest amount after the service"
                android:textAlignment="center"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/onlineOrderbtn"
                android:layout_width="@dimen/_200sdp"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:text="Pay &amp; Place order"
                android:textSize="20dp"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:background="@drawable/grey_rectangle_box"
                android:padding="5dp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cashlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:background="@drawable/grey_rectangle_box"
            android:orientation="vertical"
            android:layout_marginBottom="10dp"
            android:padding="@dimen/_8sdp">

            <TextView
               android:id="@+id/pay_cashtxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                  android:textColor="@color/quantum_googgreen"
                android:drawableStart="@drawable/ic_tick_nonactive"
                android:drawablePadding="@dimen/_10sdp"
                android:text="@string/cash_payment"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />




            <TextView
                android:id="@+id/manaul_handfee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/_8226_manual_hand_fee_is_applicable_100"
               android:layout_marginRight="@dimen/_5ssp"
                android:textAlignment="center"
                android:textSize="@dimen/_10ssp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

            <TextView

                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:visibility="invisible"
                android:textAlignment="center"
                android:layout_marginRight="@dimen/_5ssp"
                android:textSize="@dimen/_10ssp"/>

                <TextView
                    android:id="@+id/payByCashTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:text="hg"
                    android:layout_marginRight="@dimen/_5ssp"
                    android:textSize="@dimen/_10ssp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/orderpricecash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="&#8226; Order Amount "
                android:visibility="gone"
                android:textAlignment="center"
                android:textSize="@dimen/_10ssp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView

                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:visibility="invisible"
                    android:textAlignment="center"
                    android:layout_marginRight="@dimen/_5ssp"
                    android:textSize="@dimen/_10ssp"/>
            <TextView
                android:id="@+id/orderToatalecash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="&#8226; Order Amount -> "
                android:textAlignment="center"
                android:layout_marginRight="@dimen/_5ssp"
                android:textSize="@dimen/_10ssp" />
            </LinearLayout>
            <TextView
                android:id="@+id/cashorderbtn"
                android:layout_width="@dimen/_150sdp"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:text=" Place order"

                android:textSize="20dp"
                android:layout_gravity="center"
                android:background="@drawable/grey_rectangle_box"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/white"
                android:padding="5dp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/placeOrderBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_30sdp"
            android:layout_marginBottom="@dimen/_45sdp"
            android:background="@color/colorPrimary"
            android:paddingLeft="@dimen/_70sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingRight="@dimen/_70sdp"
            android:visibility="gone"
            android:paddingBottom="@dimen/_5sdp"
            android:text="@string/placeOrder"
            android:textColor="#fff"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/error_text"
            android:text="ghjk"
            android:visibility="gone"
            android:textColor="@color/black"
            android:layout_gravity="center"/>

    </LinearLayout>


</ScrollView>